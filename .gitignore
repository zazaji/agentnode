# ============================================================
# AgentNode — 安全排除规则
# 只提交产品代码 + 编译产物（wheel/deb）；测试代码与敏感配置一律不传。
# ============================================================

# ---- 敏感/机密：token、环境变量、密钥、凭据（绝不入库）----
.env
*.env
.env.*
.e2e-tokens.env
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa*
id_ed25519*
.ssh/
.credentials
.aws/
.gcloud/
.kube/
*secret*
*_token*
token_*.txt
.gh_token
.github_token

# ---- 本机部署敏感配置（含 worker_secret / token hash / peer token）----
config.yaml
config.yaml.bak
config.local.yaml
config.prod.yaml
*.local.yaml
service.env
.envrc

# ---- 测试代码（按约定不发布到 GitHub）----
tests/
# 测试方法论文档/报告（引用本机私有测试基建，外部不可复现，不随仓库发布）
TEST_REPORT.md
docs/TESTING.md
scripts/acceptance_e2e.py
scripts/mcp_conformance_server.py
scripts/smoke-posix.sh
scripts/smoke-windows.ps1
scripts/remote/e2e_mesh_matrix.py
scripts/agentnode-repo.zip

# ---- 虚拟环境 / Python 产物 ----
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.so
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.coverage.*
*.egg-info/

# ---- 构建中间物 / 运行数据 / 日志 ----
build/
dist/*.zip
data/
*.log
serve.log
notes/
*.pid
*.sock
node_modules/

# ---- 编辑器 / 系统 / 临时 ----
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.tmp/
*.tmp
.zcode/
config.yaml.bak-*
.qwen/
scripts/remote/configure.py
